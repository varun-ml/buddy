#!/usr/bin/env python3
"""buddy: start Buddy, or let any agent tell you something through it.

  buddy                         start Buddy again (after right-click → Close Buddy)
  buddy say "text" [--urgent] [--sticky KEY]
                                show a bubble; tapping it opens the session in this folder
                                --urgent: waiting-for-you sound, and it jumps the queue
                                --sticky KEY: the bubble stays until you tap it or something runs `buddy done KEY`
  buddy done KEY                clear the sticky bubble KEY (e.g. once the user has answered)
  buddy pair                    show the QR code the Buddy phone app scans (needs "phone": true, see README)
"""
import json, os, subprocess, sys, time

args = sys.argv[1:]
if not args:
    subprocess.run(['launchctl', 'kickstart', f'gui/{os.getuid()}/com.buddy-pet.buddy'])
    sys.exit()
done_dir = os.path.expanduser('~/.claude/pet/done')
if args == ['pair']:
    sys.exit(subprocess.run(['python3', os.path.join(os.path.dirname(os.path.realpath(__file__)), 'phone.py'), '--pair']).returncode)
if args[0] == 'done' and len(args) == 2:
    os.makedirs(done_dir, exist_ok=True)
    open(os.path.join(done_dir, os.path.basename(args[1])), 'w').close()   # Buddy clears that bubble within 2 s
    print('Cleared.'); sys.exit()
if args[0] != 'say' or len(args) < 2:
    print(__doc__); sys.exit(2)
urgent = '--urgent' in args
sticky = None
if '--sticky' in args:
    i = args.index('--sticky')
    if i + 1 >= len(args): print(__doc__); sys.exit(2)
    sticky = os.path.basename(args[i + 1]); del args[i:i + 2]
    try: os.remove(os.path.join(done_dir, sticky))   # a fresh bubble with an old key starts uncleared
    except FileNotFoundError: pass
text = ' '.join(a for a in args[1:] if a != '--urgent').strip()[:300]
if not text:
    print(__doc__); sys.exit(2)
inbox = os.path.expanduser('~/.claude/pet/inbox')
os.makedirs(inbox, exist_ok=True)
path = os.path.join(inbox, f'{time.time():.3f}-{os.getpid()}.json')
with open(path + '.tmp', 'w') as f:
    json.dump({'text': text, 'urgent': urgent, 'sticky': sticky, 'cwd': os.getcwd(), 'ts': time.time()}, f)
os.replace(path + '.tmp', path)   # Buddy reads it within 2 s; it keeps for 2 h if Buddy is closed
phone = os.environ.get('BUDDY_PHONE') or os.path.expanduser('~/.claude/pet/phone')
if os.path.isdir(phone):   # the phone server (phone.py) is set up: it reads these and sends them to the phone
    with open(os.path.join(phone, 'say.jsonl'), 'a') as f:
        f.write(json.dumps({'text': text, 'urgent': urgent, 'sticky': sticky, 'cwd': os.getcwd(), 'ts': time.time()}) + '\n')
print('Buddy will show it.')
